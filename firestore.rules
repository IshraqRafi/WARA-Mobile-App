rules_version = '2';

// Data model (see lib/core/services/firestore_service.dart):
//   users/{uid}                         profile; holds role + agencyId
//   agencies/{agencyId}                 agency doc (managerUid, joinKey)
//     conversations/{convoId}           chat channels + DMs
//       messages/{msgId}
//     notifications/{notifId}       legacy, locked
//   users/{uid}/notifications/{id}    per-user inbox
//   projects/{projectId}                flat collection, each doc has agencyId
//
// Policy: every request must be signed in to Firebase Auth. Agency-owned data
// is scoped to the caller's users/{uid}.agencyId. Profiles are readable by the
// owner and by members of the same agency. Agency docs are readable by their
// members only; editors resolve a join key through joinKeys/{KEY}. A profile's
// role and agencyId are locked once set (see validMembership). Direct messages
// (conversations/dm_*) are limited to their participantIds.
// Bulk deletes are not allowed anywhere.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myAgency() { return me().get('agencyId', ''); }
    function isManager() { return me().get('role', '') == 'manager'; }
    function inAgency(agencyId) { return signedIn() && myAgency() != '' && myAgency() == agencyId; }
    function agencyPath(agencyId) { return /databases/$(database)/documents/agencies/$(agencyId); }

    // Membership a profile may claim for itself (no Cloud Functions needed):
    //  - a manager only for an agency whose managerUid is them (getAfter, so
    //    the agency and the profile can be written in one batch), or
    //  - an editor only with the agency's CURRENT joinKey in agencyJoinKey.
    function validMembership(uid, data) {
      return data.get('agencyId', '') == ''
        || (data.get('role', '') == 'manager'
            && existsAfter(agencyPath(data.agencyId))
            && getAfter(agencyPath(data.agencyId)).data.managerUid == uid)
        || (data.get('role', '') == 'editor'
            && data.get('agencyJoinKey', '') != ''
            && exists(agencyPath(data.agencyId))
            && get(agencyPath(data.agencyId)).data.joinKey == data.agencyJoinKey);
    }
    function ratingKeys() {
      return ['rating', 'ratingCount', 'totalStars', 'completedProjects', 'lastRatedAt', 'latestFeedback'];
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid
            || (myAgency() != '' && resource.data.get('agencyId', '') == myAgency()));
      // Self create: role is editor or manager, membership must be proven.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', '') in ['editor', 'manager']
        && validMembership(uid, request.resource.data)
        && !request.resource.data.keys().hasAny(ratingKeys());
      // Self update: role is locked once set; agencyId can only go from
      // empty to a proven agency, never change after; ratings are managers'.
      allow update: if signedIn() && request.auth.uid == uid
        && (request.resource.data.get('role', null) == resource.data.get('role', null)
            || (resource.data.get('role', null) == null
                && request.resource.data.get('role', '') in ['editor', 'manager']))
        && (request.resource.data.get('agencyId', '') == resource.data.get('agencyId', '')
            || (resource.data.get('agencyId', '') == ''
                && validMembership(uid, request.resource.data)))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(ratingKeys())
        // availability: editors only, 'available' or 'busy'.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['availability'])
            || (request.resource.data.get('role', '') == 'editor'
                && request.resource.data.availability in ['available', 'busy']));
      // Managers rate editors (FirestoreService.rateEditor): rating fields only.
      allow update: if signedIn() && isManager()
        && myAgency() != '' && resource.data.get('agencyId', '') == myAgency()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['rating', 'ratingCount', 'totalStars', 'completedProjects',
                       'lastRatedAt', 'latestFeedback']);
      allow delete: if false;
    }

    // In-app notifications (no Cloud Functions): the sender's client writes
    // into the recipient's inbox. Managers notify their editors; editors
    // notify their own manager (messages, submissions). Only the recipient
    // reads, marks read, or deletes.
    match /users/{uid}/notifications/{notifId} {
      function recipient() { return get(/databases/$(database)/documents/users/$(uid)).data; }
      function optStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() > 0 && d[k].size() <= n); }
      function validNotif(d) {
        return d.keys().hasOnly(['type', 'projectId', 'chatId', 'title', 'body', 'fromUid', 'createdAt', 'read'])
          && d.keys().hasAll(['type', 'title', 'body', 'fromUid', 'createdAt', 'read'])
          && d.type in ['revision', 'approved', 'message', 'assigned', 'submitted']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.body is string && d.body.size() <= 500
          && d.read == false
          && d.createdAt == request.time
          && optStr(d, 'projectId', 128) && optStr(d, 'chatId', 128);
      }
      function allowedPair(type) {
        return (isManager() && recipient().get('role', '') == 'editor'
                && type in ['revision', 'approved', 'message', 'assigned'])
          || (me().get('role', '') == 'editor' && recipient().get('role', '') == 'manager'
                && type in ['message', 'submitted']);
      }
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create: if signedIn() && request.auth.uid != uid
        && request.resource.data.fromUid == request.auth.uid
        && validNotif(request.resource.data)
        && myAgency() != '' && recipient().get('agencyId', '') == myAgency()
        && allowedPair(request.resource.data.type);
    }

    match /agencies/{agencyId} {
      // Members and the owner only; join keys are resolved via joinKeys/.
      allow read: if signedIn() && (resource.data.managerUid == request.auth.uid || inAgency(agencyId));
      allow create: if signedIn() && request.resource.data.managerUid == request.auth.uid;
      allow update: if signedIn() && (resource.data.managerUid == request.auth.uid
                                      || (isManager() && inAgency(agencyId)))
        && request.resource.data.managerUid == resource.data.managerUid;
      allow delete: if false;

      match /conversations/{convoId} {
        function isDm() { return convoId.matches('dm_.*'); }
        function convoPath() {
          return /databases/$(database)/documents/agencies/$(agencyId)/conversations/$(convoId);
        }
        // Checked on document data (not the id) so list queries can be
        // proven: channels by type == 'channel', DMs by participantIds.
        function convoType(data) { return data.get('type', 'channel'); }
        function canSee(data) {
          return convoType(data) == 'channel'
            || request.auth.uid in data.get('participantIds', []);
        }

        // resource == null lets a participant probe a DM before it exists.
        allow read: if inAgency(agencyId) && (resource == null || canSee(resource.data));
        allow create: if inAgency(agencyId) && canSee(request.resource.data)
          && (isDm() == (convoType(request.resource.data) == 'direct'));
        allow update: if inAgency(agencyId) && canSee(resource.data)
          && convoType(request.resource.data) == convoType(resource.data)
          && request.resource.data.get('participantIds', [])
               == resource.data.get('participantIds', []);
        allow delete: if false;

        match /messages/{msgId} {
          allow read: if inAgency(agencyId)
            && (!exists(convoPath()) ? !isDm() : canSee(get(convoPath()).data));
          allow create, update: if inAgency(agencyId)
            && existsAfter(convoPath()) && canSee(getAfter(convoPath()).data);
          allow delete: if false;
        }
      }

      // Legacy agency-wide feed, replaced by users/{uid}/notifications.
      // Locked; existing docs are left in place (not deleted).
      match /notifications/{notifId} {
        allow read, write: if false;
      }
    }

    // joinKeys/{KEY} -> {agencyId, agencyName, createdAt}. Get by exact key
    // only (no listing). Only the agency's manager writes it, and only for
    // the key that is (or, in the same batch, becomes) the agency's joinKey.
    match /joinKeys/{key} {
      function ownsAgency(agencyId) {
        return existsAfter(agencyPath(agencyId))
          && getAfter(agencyPath(agencyId)).data.managerUid == request.auth.uid;
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && ownsAgency(request.resource.data.agencyId)
        && getAfter(agencyPath(request.resource.data.agencyId)).data.joinKey == key
        && request.resource.data.keys().hasOnly(['agencyId', 'agencyName', 'createdAt']);
      allow update: if signedIn() && ownsAgency(resource.data.agencyId)
        && request.resource.data.agencyId == resource.data.agencyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agencyName']);
      allow delete: if signedIn() && ownsAgency(resource.data.agencyId);
    }

    match /projects/{projectId} {
      function projectPath() { return /databases/$(database)/documents/projects/$(projectId); }

      // The client price never lives on the project doc (editors read it);
      // it is in private/finance. A legacy clientBudget may only be removed.
      allow read: if inAgency(resource.data.agencyId);
      allow create: if isManager() && inAgency(request.resource.data.agencyId)
        && !('clientBudget' in request.resource.data);
      // submissionVersion only moves +1, on a submit, by the claimed editor.
      function versionOk() {
        let before = resource.data.get('submissionVersion', 0);
        let after = request.resource.data.get('submissionVersion', 0);
        return after == before
          || (after == before + 1
              && request.resource.data.status == 'submitted'
              && resource.data.get('claimedByEditorId', '') == request.auth.uid);
      }
      // revisionChecks: ticked by the claimed editor (or a manager).
      function checksOk() {
        return request.resource.data.get('revisionChecks', []) == resource.data.get('revisionChecks', [])
          || isManager()
          || resource.data.get('claimedByEditorId', '') == request.auth.uid;
      }
      allow update: if inAgency(resource.data.agencyId)
        && request.resource.data.agencyId == resource.data.agencyId
        && (!('clientBudget' in request.resource.data)
            || request.resource.data.clientBudget == resource.data.get('clientBudget', null))
        && versionOk()
        && checksOk();
      allow delete: if isManager() && inAgency(resource.data.agencyId);

      // projects/{id}/private/finance: clientPrice, currency, updatedAt,
      // updatedBy. Managers of the project's agency only. getAfter() lets the
      // project and its finance doc be written in one batch.
      match /private/{docId} {
        allow read: if docId == 'finance' && isManager()
          && exists(projectPath()) && inAgency(get(projectPath()).data.agencyId);
        allow create, update: if docId == 'finance' && isManager()
          && existsAfter(projectPath()) && inAgency(getAfter(projectPath()).data.agencyId)
          && request.resource.data.keys().hasOnly(['clientPrice', 'currency', 'updatedAt', 'updatedBy'])
          && request.resource.data.clientPrice is number && request.resource.data.clientPrice >= 0;
        allow delete: if docId == 'finance' && isManager()
          && exists(projectPath()) && inAgency(get(projectPath()).data.agencyId);
      }
    }
  }
}
